# Public site URL used for canonical links, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://teameit.com

# TEAMeIT application (authenticated product). Login and signup CTAs use this origin.
NEXT_PUBLIC_APP_URL=https://app.teameit.com

# Optional: server-only webhook that receives validated contact and data-deletion form posts.
# Do not prefix with NEXT_PUBLIC. Never put API keys, OAuth secrets, or service-role keys here.
# CONTACT_WEBHOOK_URL=
