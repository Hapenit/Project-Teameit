# ============================================================
# TEAMEIT API — Environment Variable Reference
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Supabase ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Secrets ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
OAUTH_STATE_SECRET=replace_with_a_long_random_secret
# Required for encrypting integration credentials (32-byte base64 recommended)
SERVER_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# --- Meta (Facebook / Instagram / WhatsApp) ---
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_for_whatsapp_webhook
INSTAGRAM_VERIFY_TOKEN=your_custom_verify_token_for_instagram_webhook
FACEBOOK_VERIFY_TOKEN=your_custom_verify_token_for_facebook_webhook
META_GRAPH_API_VERSION=v21.0
# Meta Ads accounts are discovered from the connected tenant token; no global account id is used.

# --- Google ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Google Ads API developer token (required for Ads resource/report calls)
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional customer ID used by scheduled Ads sync (digits only, no hyphens)
GOOGLE_ADS_CUSTOMER_ID=
# Optional GA4 property and Search Console site used by scheduled sync
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# --- URLs ---
# Public URL of this API (used for OAuth redirect URIs)
API_BASE_URL=http://localhost:3001
# Frontend URL (used for post-OAuth redirects)
FRONTEND_URL=http://localhost:5173

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_VERSION=202506
LINKEDIN_API_BASE_URL=https://api.linkedin.com

# --- Twilio SMS ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+10000000000
SMS_PROVIDER=twilio
TWILIO_PHONE_NUMBER=+10000000000
# Public HTTPS URL required for delivery webhooks and unsubscribe links
CAMPAIGN_PUBLIC_URL=http://localhost:3001

# --- Billing (optional) ---
# When unset, billing endpoints explicitly report "unconfigured" and checkout is disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
