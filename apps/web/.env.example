# ============================================================
# TEAMEIT WEB — Environment Variable Reference
# Copy this file to .env and fill in your values
# Only VITE_ prefixed variables are exposed to the browser bundle
# ============================================================

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API base URL — where the Teameit backend is running
VITE_API_URL=http://localhost:3001

# Public marketing site (Terms / Privacy links on signup)
VITE_MARKETING_URL=http://localhost:3000
